<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- This web project lives beside other projects. Exclude every nested project
         and all generated build files so their source/AssemblyInfo files are not
         compiled a second time by the MVC project. -->
    <Compile Remove="GiftOfTheGivers.Functions\**\*.cs" />
    <Compile Remove="GiftOfTheGivers.Helpers\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="**\bin\**\*.cs" />
    <Compile Remove="**\obj\**\*.cs" />
    <Content Remove="GiftOfTheGivers.Functions\**" />
    <Content Remove="GiftOfTheGivers.Helpers\**" />
    <Content Remove="Tests\**" />
    <EmbeddedResource Remove="GiftOfTheGivers.Functions\**" />
    <EmbeddedResource Remove="GiftOfTheGivers.Helpers\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="GiftOfTheGivers.Functions\**" />
    <None Remove="GiftOfTheGivers.Helpers\**" />
    <None Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.UI" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="GiftOfTheGivers.Helpers\GiftOfTheGivers.Helpers.csproj" />
  </ItemGroup>

</Project>
